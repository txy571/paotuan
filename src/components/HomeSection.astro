<section class="page active" id="page-home">
  <div class="hero">
    <h1>选择你的冒险规则</h1>
    <p>选择一套规则系统开始跑团之旅——不同规则将带来完全不同的视觉体验与专属工具。</p>
  </div>

  <!-- Character Selector -->
  <div class="char-select-section" id="homeCharSelect">
    <div class="char-select-header">
      <h3>🎭 选择你的角色</h3>
      <button class="btn btn-sm btn-secondary" data-action="nav:go" data-page="character">+ 创建新角色</button>
    </div>
    <div class="char-select-list" id="homeCharList">
      <div class="char-select-empty">还没有角色——去"人物卡"页面捏一个，或者点右边的按钮快速创建一个</div>
    </div>
  </div>

  <!-- AI KP Hero Banner -->
  <div class="kp-hero" id="kpHero" data-action="kp:open">
    <div class="kp-hero-inner">
      <div class="kp-hero-icon">AI</div>
      <div class="kp-hero-text">
        <h2>AI 主持人 (KP/DM) — 即刻开始跑团</h2>
        <p>接入 AI 大模型作为你的专属游戏主持人。自动适配当前规则系统，实时叙述、判定、扮演 NPC。支持 Anthropic Claude 和 OpenAI 兼容接口。不同规则系统下的游戏会话互相独立。</p>
        <span class="kp-hero-badge" id="kpHeroBadge">选择角色后，点击这里开始冒险</span>
      </div>
      <div class="kp-hero-arrow">▶</div>
    </div>
  </div>

  <!-- AI KP Chat Interface -->
  <div class="kp-chat-wrapper" id="kpChatWrapper" style="display:none;">
    <div class="panel">
      <div class="panel-header">
        <h3>AI 主持人 <span class="kp-theme-tag">(<span id="kpCurrentTheme">D&D 5e</span>)</span></h3>
        <div class="panel-actions">
          <button class="btn btn-ghost btn-xs" data-action="kp:newGame" title="新建游戏">🆕 新建</button>
          <button class="btn btn-ghost btn-xs" data-action="kp:endGame" title="结束游戏并存档">🏁 结束</button>
          <button class="btn btn-ghost btn-xs" data-action="nav:go" data-page="config" title="前往配置页">设置</button>
          <button class="btn btn-ghost btn-xs" data-action="scenario:toggle" title="剧本知识库">剧本库</button>
          <button class="btn btn-ghost btn-xs" data-action="kp:clear" title="清空对话">清空</button>
          <button class="btn btn-ghost btn-xs" data-action="tts:toggle" id="ttsToggleBtn" title="语音输出" style="opacity:.5;">🔇</button>
          <button class="btn btn-ghost btn-xs" data-action="kp:close" title="收起">✕</button>
        </div>
      </div>

      <!-- Config moved to the Config page (#page-config) -->

      <!-- CoC Status Mini (CoC theme only) -->
      <div class="coc-status-mini" id="cocStatusMini"></div>

      <!-- Universal Status Bar (HP/SAN for all themes, always visible during game) -->
      <div class="kp-status-bar" id="kpUniversalStatus"></div>

      <!-- Main KP Layout: Chat (left) + Tracking (right) -->
      <div class="kp-main-layout">
        <!-- Left: Chat Column -->
        <div class="kp-left-column">
          <div class="kp-chat-panel" id="kpChatPanel">
            <div class="kp-chat-msgs" id="kpMessages"></div>
            <div id="kpDiceCardContainer" style="display:none;padding:0 4px 8px;"></div>
            <div class="kp-action-buttons" id="kpActionButtons" style="display:none;"></div>
            <div class="kp-quick-actions" id="kpQuickActions"></div>
            <!-- TTS Controls -->
            <div id="kpTtsControls" style="display:none;padding-top:6px;font-size:.72rem;color:var(--text-dim);align-items:center;gap:8px;flex-wrap:wrap;">
              <span>🔊 <span id="ttsStatusLabel">语音就绪</span></span>
              <button class="btn btn-ghost btn-xs" data-action="tts:stop" id="ttsStopBtn" style="display:none;font-size:.7rem;">■ 停止语音</button>
            </div>
            <div class="kp-input-row">
              <input type="text" id="kpInput" placeholder="输入你的行动、对话或问题... (Enter 发送)">
              <button class="btn btn-primary btn-sm" id="kpSendBtn" data-action="kp:send">发送</button>
              <button class="btn btn-danger btn-sm" id="kpStopBtn" data-action="kp:stop" style="display:none;">停止</button>
            </div>
          </div>
        </div>

        <!-- Right: Tracking Panel -->
        <div class="kp-right-column" id="kpRightColumn">
          <div class="kp-tracking-header">
            <span class="kp-tracking-title">📋 剧本追踪</span>
            <button class="btn btn-ghost btn-xs" id="kpTrackingToggle" data-action="tracking:toggle">◀</button>
          </div>
          <div class="kp-tracking-body" id="kpTrackingPanel"></div>
        </div>
      </div>
    </div>

    <!-- Game Save & Chronicle -->
    <div class="game-save-chronicle" style="display:flex;gap:16px;margin-top:16px;flex-wrap:wrap;">
      <div class="panel" style="flex:1;min-width:240px;">
        <div class="panel-header">
          <h3 style="margin-bottom:0;">游戏存档</h3>
          <div style="display:flex;gap:4px;">
            <button class="btn btn-xs btn-ghost" data-action="kp:newGame" title="开始新游戏">🆕 新建</button>
            <button class="btn btn-xs btn-ghost" data-action="kp:endGame" title="结束当前游戏">🏁 结束</button>
          </div>
        </div>
        <div style="display:flex;gap:6px;margin-bottom:8px;">
          <input type="text" id="gameSaveSlot" placeholder="存档名称..." style="flex:1;font-size:.82rem;">
          <button class="btn btn-save btn-xs" data-action="saves:save">存档</button>
        </div>
        <div class="btn-row" style="margin-bottom:8px;">
          <button class="btn btn-ghost btn-xs" data-action="saves:autosave">读自动档</button>
        </div>
        <div id="gameSavesList" style="max-height:200px;overflow-y:auto;"></div>
      </div>
      <div class="panel" style="flex:2;min-width:300px;">
        <h3 style="margin-bottom:10px;">冒险编年史</h3>
        <div id="cocChronicle" style="max-height:200px;overflow-y:auto;"></div>
        <div style="margin-top:6px;font-size:.72rem;color:var(--text-dim);">
          技能提升标记: <span id="cocSkillChecks"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Structured Scenario Library -->
  <div class="scenario-library-wrapper" id="scenarioLibraryWrapper" style="display:none;margin-bottom:20px;">
    <div class="panel">
      <div class="panel-header">
        <h3>📚 剧本库 <span style="font-size:.7rem;font-weight:400;color:var(--text-dim);" id="scenarioActiveLabel"></span></h3>
        <div class="panel-actions">
          <button class="btn btn-ghost btn-xs" data-action="scenario:new">+ 新建</button>
          <button class="btn btn-ghost btn-xs" data-action="scenario:export">导出</button>
          <button class="btn btn-ghost btn-xs" data-action="scenario:import">导入</button>
          <button class="btn btn-ghost btn-xs" data-action="scenario:close">✕</button>
        </div>
      </div>
      <p style="font-size:.75rem;color:var(--text-dim);margin-bottom:10px;">
        创建结构化剧本：设定背景、NPC、地点、线索和剧情钩子。激活剧本后，AI主持人将严格遵循设定推进故事。
      </p>
      <div id="scenarioLibraryList"></div>
      <div id="scenarioEditForm" style="display:none;margin-top:14px;border-top:1px solid var(--border);padding-top:14px;"></div>
      <!-- Legacy freeform textarea (hidden, kept for data compatibility) -->
      <textarea id="scenarioDbContent" style="display:none;"></textarea>
    </div>
  </div>

  <!-- RPG System Selection Cards -->
  <div class="rpg-grid">
    <div class="rpg-card dnd-card selected" data-action="theme:select" data-theme="dnd">
      <div class="rpg-card-icon">D</div>
      <h3>龙与地下城 5e</h3>
      <div class="subtitle">Dungeons &amp; Dragons 5th Edition</div>
      <p>剑与魔法的史诗冒险。探索被遗忘的国度，对抗远古巨龙，在奇幻世界中书写传奇篇章。</p>
      <div class="tags">
        <span class="tag">奇幻</span><span class="tag">中世纪</span><span class="tag">d20系统</span><span class="tag">高魔世界</span>
      </div>
    </div>
    <div class="rpg-card coc-card" data-action="theme:select" data-theme="coc">
      <div class="rpg-card-icon">C</div>
      <h3>克苏鲁的呼唤</h3>
      <div class="subtitle">Call of Cthulhu 7th Edition</div>
      <p>踏入不可名状的恐怖深渊。调查诡异事件，直面宇宙的疯狂真相，在理智崩溃的边缘求生。</p>
      <div class="tags">
        <span class="tag">恐怖</span><span class="tag">调查</span><span class="tag">d100系统</span><span class="tag">宇宙恐怖</span>
      </div>
    </div>
    <div class="rpg-card cyberpunk-card" data-action="theme:select" data-theme="cyberpunk">
      <div class="rpg-card-icon">R</div>
      <h3>赛博朋克 红</h3>
      <div class="subtitle">Cyberpunk RED</div>
      <p>高科技，低生活。在霓虹浸染的夜之城中，用赛博义体和尖端科技武装自己，对抗巨型企业的铁幕。</p>
      <div class="tags">
        <span class="tag">科幻</span><span class="tag">赛博朋克</span><span class="tag">d10系统</span><span class="tag">反乌托邦</span>
      </div>
    </div>
    <div class="rpg-card pathfinder-card" data-action="theme:select" data-theme="pathfinder">
      <div class="rpg-card-icon">P</div>
      <h3>开拓者</h3>
      <div class="subtitle">Pathfinder 2nd Edition</div>
      <p>无限深度的策略奇幻。丰富的职业定制选项，精密的战术战斗系统，打造真正独一无二的传奇英雄。</p>
      <div class="tags">
        <span class="tag">奇幻</span><span class="tag">策略</span><span class="tag">d20系统</span><span class="tag">深度定制</span>
      </div>
    </div>
  </div>

  <!-- Theme-conditional Reference Section -->
  <div class="panel api-section" id="apiSection">
    <h3 id="apiSectionTitle">D&amp;D 5e 在线资源库</h3>
    <!-- D&D / Pathfinder: API browser -->
    <div id="apiBrowserControls">
      <div class="btn-row">
        <button class="btn btn-secondary btn-sm" data-action="api:fetch" data-endpoint="races">种族</button>
        <button class="btn btn-secondary btn-sm" data-action="api:fetch" data-endpoint="classes">职业</button>
        <button class="btn btn-secondary btn-sm" data-action="api:fetch" data-endpoint="spells">法术</button>
        <button class="btn btn-secondary btn-sm" data-action="api:fetch" data-endpoint="monsters">怪物</button>
        <button class="btn btn-secondary btn-sm" data-action="api:fetch" data-endpoint="equipment">装备</button>
        <button class="btn btn-secondary btn-sm" data-action="api:fetch" data-endpoint="feats">专长</button>
      </div>
      <div id="apiResults" style="max-height:500px;overflow-y:auto;margin-top:12px;"></div>
    </div>
    <!-- CoC: cthulhuclub.com reference -->
    <div id="cocReference" style="display:none;">
      <div class="coc-reference-card">
        <div class="coc-reference-icon">🐙</div>
        <div class="coc-reference-content">
          <h4>克苏鲁俱乐部 — CoC 7e 在线规则参考</h4>
          <p>全面的克苏鲁的呼唤第七版规则资料、调查员创建指南、魔法典籍与怪物图鉴。</p>
          <a href="https://www.cthulhuclub.com/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
            访问 cthulhuclub.com ↗
          </a>
        </div>
      </div>
    </div>
    <!-- Cyberpunk reference -->
    <div id="cyberpunkReference" style="display:none;">
      <div class="coc-reference-card">
        <div class="coc-reference-icon">🤖</div>
        <div class="coc-reference-content">
          <h4>赛博朋克 RED 规则参考</h4>
          <p>赛博朋克 RED 核心规则书。更多在线资源持续添加中。</p>
        </div>
      </div>
    </div>
  </div>
</section>
